# Only needed when switching the demo from the mock provider to real generation.
OPENROUTER_API_KEY=

# Personal access token with file_content:read and access to the selected Figma file.
# Read only by the create command; never embedded in plans, image downloads, or videos.
FIGMA_ACCESS_TOKEN=

# Optional live text planning. Rules/replay mode makes no model API calls.
OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=gpt-5.5
OPENAI_COPY_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
ANTHROPIC_PLANNER_MODEL=claude-sonnet-5
ANTHROPIC_COPY_MODEL=claude-haiku-4-5
