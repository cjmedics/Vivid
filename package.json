{
  "name": "vivid",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "create": "node --env-file-if-exists=.env --import tsx apps/create/src/main.ts",
    "create:sample": "npm run create -- --figma https://www.figma.com/design/VividFixture/Launchboard?node-id=1-2 --figma-json fixtures/design.nodes.json --capture fixtures/design.capture.png --brand fixtures/design.brand.json --brief fixtures/design.brief.json --out out/design-sample",
    "create:planned-sample": "npm run create:sample -- --planner-replay fixtures/planner.suggestions.json --accept-copy --out out/planned-sample",
    "create:layered-sample": "npm run create:sample -- --layers --figma-svg fixtures/design.layers.svg --out out/layered-sample",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo": "tsx apps/demo/src/main.ts",
    "studio": "npm run studio -w @vivid/renderer",
    "render:demo": "tsx apps/demo/src/main.ts --write-plan && npm run render -w @vivid/renderer"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
