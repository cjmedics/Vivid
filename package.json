{
  "name": "vivid",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo": "tsx apps/demo/src/main.ts",
    "studio": "npm run studio -w @vivid/renderer",
    "render:demo": "tsx apps/demo/src/main.ts --write-plan && npm run render -w @vivid/renderer"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
